{
  "description": "DPD only: canonical trailing slash including query strings; review ordering before enabling",
  "expression": "(http.host eq \"smartkea.com\" and http.request.uri.path eq \"/introduccion-dpd\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {"value": "https://smartkea.com/introduccion-dpd/"},
      "preserve_query_string": true
    }
  },
  "enabled": false
}
